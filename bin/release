#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o nounset -o errexit -o pipefail

# The only way to release, from master, the one branch: it runs the tests,
# bumps the version, commits it, tags it and pushes both. It builds and
# pushes no image: the v* tag starts .github/workflows/release.yml, which
# checks the tagged commit again and only then pushes the image.

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

RED="\e[31m"
GREEN="\e[32m"
RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/release failed${RESET}"
trap 'echo -e $EXIT_MESSAGE' EXIT

cd $scriptdir/..

case "${1-}" in
major|minor|patch)
    ;;
*)
    echo usage: release 'major|minor|patch' >&2
    exit 1
    ;;
esac

if test `git rev-parse --abbrev-ref HEAD` != master; then
    echo error: switch branch to master >&2
    exit 1
fi

if test -n "`git status -s`"; then
    echo error: there is changes >&2
    exit 1
fi

# A master behind origin would fail at the push, after the release commit
# and its tag were made here.
git fetch origin master
if test `git rev-list --count HEAD..origin/master` != 0; then
    echo error: master is behind origin/master, pull first >&2
    exit 1
fi

bin/test

# Increase a version without committing it and making a tag
npm version $1 --no-git-tag-version

version=$(node -p "require('./package.json').version")
tag=v$version
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    git checkout -- package.json package-lock.json
    echo -e "${RED}error: tag $tag already exists${RESET}" >&2
    exit 1
fi

git add package.json package-lock.json
git commit -m "release $tag"
git tag $tag

# The v* tag starts .github/workflows/release.yml
git push
git push --tags

EXIT_MESSAGE="${GREEN}bin/release succeeded: $tag pushed, its run releases the image${RESET}"
