#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const config = require('../config');
const db_from_knexvars = require('../src/helpers/db_from_knexvars');
const format_database = require('../src/helpers/format/format_database');

cli(main);

// Applies the pending migrations, in one batch, to the database AUTHWALL_DB
// names: the one the server migrates when it starts. The Knex CLI it wrapped
// took --env=sqlite, data/db.sqlite3 whatever AUTHWALL_DB said (M-11).
async function main()
{
    if (process.argv.length > 2) {
        console.error('Usage: bin/migrate');
        process.exit(1);
    }

    const db = db_from_knexvars(config.knexvars);
    await using _ = {[Symbol.asyncDispose]: () => db.destroy()};

    console.log(`🗄️ ${format_database(config.knexvars)}`);
    const [batch, files] = await db.migrate.latest();
    if (!files.length) {
        console.log('Already up to date');
        return;
    }
    console.log(`Batch ${batch}: ${files.length} applied`);
    for (const file of files) {
        console.log(`  ${file}`);
    }
}
